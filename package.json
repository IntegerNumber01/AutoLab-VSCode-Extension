{
  "name": "autolab",
  "displayName": "Autolab",
  "description": "Download, work on, submit, and review Autolab assignments without leaving VS Code.",
  "version": "0.3.0",
  "engines": {
    "vscode": "^1.104.0"
  },
  "categories": [
    "Other"
  ],
  "keywords": [
    "autolab",
    "education",
    "assignments",
    "autograding",
    "student"
  ],
  "license": "MIT",
  "activationEvents": [
    "onView:autolab.account",
    "onView:autolab.assignments",
    "onView:autolab.submissions"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "autolab",
          "title": "Autolab",
          "icon": "resources/logo.svg"
        }
      ]
    },
    "views": {
      "autolab": [
        {
          "id": "autolab.account",
          "name": "ACCOUNT"
        },
        {
          "id": "autolab.assignments",
          "name": "LABS"
        },
        {
          "id": "autolab.submissions",
          "name": "CURRENT LAB"
        }
      ]
    },
    "commands": [
      {
        "command": "autolab.setup",
        "title": "Set Up Autolab",
        "category": "Autolab",
        "icon": "$(rocket)"
      },
      {
        "command": "autolab.signIn",
        "title": "Sign In",
        "category": "Autolab",
        "icon": "$(sign-in)"
      },
      {
        "command": "autolab.signOut",
        "title": "Sign Out",
        "category": "Autolab"
      },
      {
        "command": "autolab.selectWorkspace",
        "title": "Choose Labs Workspace Folder",
        "category": "Autolab"
      },
      {
        "command": "autolab.openSettings",
        "title": "Open Settings",
        "category": "Autolab",
        "icon": "$(gear)"
      },
      {
        "command": "autolab.refresh",
        "title": "Refresh",
        "category": "Autolab",
        "icon": "$(refresh)"
      },
      {
        "command": "autolab.download",
        "title": "Download Lab",
        "category": "Autolab",
        "icon": "$(cloud-download)"
      },
      {
        "command": "autolab.openLab",
        "title": "Open Lab in New Window",
        "category": "Autolab",
        "icon": "$(link-external)"
      },
      {
        "command": "autolab.submit",
        "title": "Submit Current Lab",
        "category": "Autolab",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "autolab.submitAssessment",
        "title": "Submit Lab",
        "category": "Autolab",
        "icon": "$(cloud-upload)"
      },
      {
        "command": "autolab.showAssessment",
        "title": "Show Lab Details",
        "category": "Autolab"
      },
      {
        "command": "autolab.showResults",
        "title": "Show Scores & Feedback",
        "category": "Autolab",
        "icon": "$(output)"
      },
      {
        "command": "autolab.toggleGrouping",
        "title": "Group Labs by Course or Status",
        "category": "Autolab",
        "icon": "$(list-tree)"
      },
      {
        "command": "autolab.addLab",
        "title": "Add Lab by URL",
        "category": "Autolab",
        "icon": "$(add)"
      },
      {
        "command": "autolab.removeLab",
        "title": "Remove Labs Added by URL",
        "category": "Autolab"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "autolab.setup",
          "when": "view == autolab.account",
          "group": "navigation@1"
        },
        {
          "command": "autolab.openSettings",
          "when": "view == autolab.account",
          "group": "navigation@2"
        },
        {
          "command": "autolab.refresh",
          "when": "view == autolab.assignments || view == autolab.submissions",
          "group": "navigation@1"
        },
        {
          "command": "autolab.submit",
          "when": "view == autolab.submissions && autolab.isLab",
          "group": "navigation@2"
        },
        {
          "command": "autolab.toggleGrouping",
          "when": "view == autolab.assignments",
          "group": "navigation@2"
        },
        {
          "command": "autolab.addLab",
          "when": "view == autolab.assignments",
          "group": "navigation@3"
        },
        {
          "command": "autolab.removeLab",
          "when": "view == autolab.assignments",
          "group": "1_autolab@1"
        }
      ],
      "view/item/context": [
        {
          "command": "autolab.download",
          "when": "view == autolab.assignments && viewItem == autolabAssessment",
          "group": "inline@1"
        },
        {
          "command": "autolab.openLab",
          "when": "view == autolab.assignments && viewItem == autolabAssessmentDownloaded",
          "group": "inline@1"
        },
        {
          "command": "autolab.submitAssessment",
          "when": "view == autolab.assignments && viewItem == autolabAssessmentDownloaded",
          "group": "inline@2"
        },
        {
          "command": "autolab.showResults",
          "when": "view == autolab.submissions && viewItem == autolabSubmission",
          "group": "inline@1"
        }
      ]
    },
    "configuration": {
      "type": "object",
      "title": "Autolab",
      "properties": {
        "autolab.host": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "description": "Base URL of your Autolab instance, for example https://autolab.example.edu."
        },
        "autolab.clientId": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Public OAuth client ID provided by your instructor or administrator. Never enter a client secret."
        },
        "autolab.workspaceFolder": {
          "type": "string",
          "default": "",
          "scope": "machine",
          "markdownDescription": "Folder where Autolab creates one course/lab directory for downloaded assignments."
        },
        "autolab.groupBy": {
          "type": "string",
          "enum": [
            "course",
            "status"
          ],
          "enumDescriptions": [
            "Group labs under the course they belong to.",
            "Group labs by what is left to do: To do, Awaiting score, Graded, Not open yet, Closed."
          ],
          "default": "course",
          "description": "How the Labs view groups assessments."
        },
        "autolab.courses": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": [],
          "scope": "window",
          "markdownDescription": "Labs to show when Autolab will not list your courses, because the OAuth application was registered without the `user_courses` scope. Each entry is a lab page URL such as `https://autolab.example.edu/courses/COURSE/assessments/LAB`, or the shorthand `COURSE/LAB`. Use **Autolab: Add Lab by URL** instead of editing this by hand."
        },
        "autolab.submissionFormat": {
          "type": "string",
          "enum": [
            "ask",
            "zip",
            "tar.gz",
            "file"
          ],
          "enumDescriptions": [
            "Ask how to package the lab on every submission.",
            "Package the lab folder as submission.zip.",
            "Package the lab folder as submission.tar.gz.",
            "Choose an existing file for every submission."
          ],
          "default": "ask",
          "description": "How to prepare files when submitting a lab."
        },
        "autolab.exclude": {
          "type": "array",
          "scope": "machine",
          "items": {
            "type": "string"
          },
          "default": [
            ".autolab/**",
            ".vscode/**",
            ".git/**",
            "node_modules/**",
            ".venv/**",
            "__pycache__/**",
            "**/.env*",
            "**/.ssh/**",
            "**/*.pem",
            "**/*.key",
            "**/*.p12",
            "**/*.pfx",
            "**/id_rsa",
            "**/id_dsa",
            "**/id_ecdsa",
            "**/id_ed25519"
          ],
          "markdownDescription": "Additional glob patterns excluded when packaging a lab folder. Environment files, private keys, `.git`, `.autolab`, `.vscode`, virtual environments, and `node_modules` are always excluded. Use exact-file submission mode when an assignment deliberately requires one normally protected file."
        },
        "autolab.allowInsecureHttp": {
          "type": "boolean",
          "default": false,
          "scope": "machine",
          "markdownDescription": "Allow plain HTTP for a trusted local development server. **Never enable this for a real student account.**"
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "mocha --ui tdd \"out/test/**/*.test.js\"",
    "test:extension": "vscode-test"
  },
  "devDependencies": {
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "@types/vscode": "^1.104.0",
    "@typescript-eslint/eslint-plugin": "^8.42.0",
    "@typescript-eslint/parser": "^8.42.0",
    "@vscode/test-cli": "^0.0.11",
    "@vscode/test-electron": "^2.5.2",
    "esbuild": "^0.25.9",
    "eslint": "^9.34.0",
    "mocha": "^11.7.2",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.2"
  },
  "dependencies": {
    "fast-glob": "^3.3.3",
    "tar": "^7.4.3"
  },
  "overrides": {
    "diff": "^8.0.3",
    "picomatch": "^2.3.2",
    "serialize-javascript": "^7.0.5"
  }
}
